{
  "name": "civiccare-ai",
  "version": "1.0.0",
  "private": true,
  "description": "CivicCare AI 2.0 — Self-Learning Smart City",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev --workspace=@civiccare/server\" \"npm run dev --workspace=@civiccare/client\"",
    "seed": "node server/seed/seed.js",
    "seed:contractors": "node server/seed/contractors.js",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
